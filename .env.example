# Chỉ dành cho môi trường phát triển với dữ liệu giả danh. Tạo mật khẩu riêng trước khi chạy.
POSTGRES_USER=rehab_dev
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD
POSTGRES_DB=rehab_dev
DATABASE_URL=postgresql+psycopg://rehab_dev:CHANGE_ME_TO_A_RANDOM_PASSWORD@127.0.0.1:5433/rehab_dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8001
# Hospital reporting days; keep backend and frontend in the same time zone.
HOSPITAL_TIMEZONE=Asia/Bangkok
VITE_HOSPITAL_TIMEZONE=Asia/Bangkok
# Default admission policy requires a completed baseline assessment.
ALLOW_TRANSFER_WITHOUT_BASELINE=false
# Private research files; use an absolute path outside frontend/public in production.
REHAB_DATA_DIR=./rehab-data
